# Copy to /opt/tombossab/deploy/.env on the box and fill in real values.
# NEVER commit the real .env.

# Postgres container init
POSTGRES_DB=tombossa
POSTGRES_USER=tombossa
POSTGRES_PASSWORD=change-me

# App datasource (host "db" = the compose service on the internal network)
DB_URL=jdbc:postgresql://db:5432/tombossa
DB_USER=tombossa
DB_PASSWORD=change-me

# SMTP password for contact@tombossabfoundation.org (mail.privateemail.com)
SMTP_PASSWORD=change-me

# Optional overrides (defaults live in application.properties)
# APP_MAIL_TO=contact@tombossabfoundation.org
# APP_CORS_ALLOWED_ORIGINS=https://tombossabfoundation.org,https://www.tombossabfoundation.org
